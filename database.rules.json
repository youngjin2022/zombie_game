{
  "rules": {
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['createdAt', 'by'])",
        "createdAt": { ".validate": "newData.isNumber()" },
        "by": { ".validate": "newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null && (data.child('players/host/uid').val() === auth.uid || data.child('players/guest/uid').val() === auth.uid)",

        ".write": "auth != null && (!data.exists() || (data.child('meta/lastActive').isNumber() && now - data.child('meta/lastActive').val() > 86400000) || (data.child('players/host/uid').val() === auth.uid && !newData.exists())) && (!newData.exists() || newData.child('players/host/uid').val() === auth.uid)",

        ".validate": "!newData.exists() || (newData.hasChildren(['meta', 'players']) && $code.length === 6 && $code.matches(/^[A-Z2-9]*$/))",

        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('players/host/uid').val() === auth.uid",
          "createdAt": { ".validate": "newData.isNumber()" },
          "lastActive": {
            ".write": "auth != null && (data.parent().parent().child('players/host/uid').val() === auth.uid || data.parent().parent().child('players/guest/uid').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          },
          "locked": { ".validate": "newData.isBoolean()" },
          "hostName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
          "started": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "players": {
          ".read": "auth != null",
          "host": {
            ".write": "auth != null && data.parent().parent().child('players/host/uid').val() === auth.uid",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "online": { ".validate": "newData.isBoolean()" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "guest": {
            ".write": "auth != null && (data.parent().parent().child('players/host/uid').val() === auth.uid || (data.exists() && data.child('uid').val() === auth.uid))",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "online": { ".validate": "newData.isBoolean()" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "requests": {
          ".read": "auth != null && data.parent().child('players/host/uid').val() === auth.uid",
          ".write": "auth != null && data.parent().child('players/host/uid').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".read": "auth != null && $uid === auth.uid",
            ".write": "auth != null && (($uid === auth.uid && (!newData.exists() || data.parent().parent().child('meta/locked').val() !== true)) || data.parent().parent().child('players/host/uid').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "at": { ".validate": "newData.isNumber()" },
            "answer": {
              ".validate": "(newData.val() === 'yes' || newData.val() === 'no' || newData.val() === 'full') && data.parent().parent().parent().child('players/host/uid').val() === auth.uid"
            },
            "$other": { ".validate": false }
          }
        },

        "view": {
          ".write": "auth != null && data.parent().child('players/host/uid').val() === auth.uid"
        },

        "round": {
          ".write": "auth != null && data.parent().child('players/host/uid').val() === auth.uid",
          "picks": {
            "guest": {
              ".write": "auth != null && data.parent().parent().parent().child('players/guest/uid').val() === auth.uid",
              ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5"
            },
            "host": {
              ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5"
            }
          },
          "want": {
            "guest": {
              ".write": "auth != null && data.parent().parent().parent().child('players/guest/uid').val() === auth.uid",
              ".validate": "newData.val() === 'repick' || newData.val() === 'lead' || newData.val() === 'coin'"
            }
          }
        },

        "chat": {
          ".write": "auth != null && (data.parent().child('players/host/uid').val() === auth.uid || data.parent().child('players/guest/uid').val() === auth.uid)",
          "$msg": {
            ".validate": "newData.hasChildren(['who', 'text', 'at'])",
            "who": {
              ".validate": "(newData.val() === 'host' && data.parent().parent().parent().child('players/host/uid').val() === auth.uid) || (newData.val() === 'guest' && data.parent().parent().parent().child('players/guest/uid').val() === auth.uid)"
            },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "state": {
          ".write": "auth != null && data.parent().child('players/host/uid').val() === auth.uid"
        }
      }
    }
  }
}
